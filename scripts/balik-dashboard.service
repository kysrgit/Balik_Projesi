# Sablon: scripts/install_pi.sh __USER__ ve __ROOT__ alanlarini doldurup
# /etc/systemd/system/balik-dashboard.service olarak kurar.
[Unit]
Description=Balon Baligi Tespit Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__ROOT__
ExecStart=__ROOT__/.venv_pi/bin/python app/dashboard/server.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
